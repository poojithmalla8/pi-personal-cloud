# Copy this file to .env and replace every placeholder with a long random value.
#   cp .env.example .env
# Never commit .env — it contains secrets.
#
# MYSQL_*  is read by the official Nextcloud image.
# MARIADB_* is read by the official MariaDB image.
# The database name, user and password must match on both sides.

MYSQL_HOST=nextcloud_db
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

MARIADB_DATABASE=nextcloud
MARIADB_USER=nextcloud
MARIADB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
MARIADB_ROOT_PASSWORD=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_PASSWORD
MARIADB_AUTO_UPGRADE=1

# Optional: pre-create the Nextcloud admin account (skip the browser wizard).
# Leave commented if you prefer to choose the admin user in the web UI.
# NEXTCLOUD_ADMIN_USER=admin
# NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Space-separated hostnames/IPs that Nextcloud should accept (no http://).
# Add your LAN IP, your Tailscale IP, and any hostname you use.
# NEXTCLOUD_TRUSTED_DOMAINS=<PI_LAN_IP> <PI_TAILSCALE_IP>
